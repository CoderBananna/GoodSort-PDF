<UserControl x:Class="NewsletterCombiner.App.FilePanel" x:Name="PanelRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:NewsletterCombiner.Core;assembly=NewsletterCombiner.Core">
  <Border x:Name="DropFrame" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" AllowDrop="True" DragOver="Files_DragOver" DragLeave="Files_DragLeave" Drop="Files_Drop">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="{Binding Heading, ElementName=PanelRoot}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Subheading, ElementName=PanelRoot}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/></StackPanel>
        <Button DockPanel.Dock="Right" Content="+ Add files" Click="Add_Click" VerticalAlignment="Top" Margin="8,0,0,0"/>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,22,0,10"><TextBlock x:Name="CountLabel" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="YearLabel" Text="YEAR LEVEL" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,26,0"/></DockPanel>
      <Grid Grid.Row="2">
        <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" KeyDown="FileList_KeyDown" SelectionChanged="Selection_Changed" AutomationProperties.Name="Document order">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Border Background="{Binding RowBackground}" CornerRadius="7" Padding="10,12" ContextMenuOpening="File_ContextMenuOpening">
              <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Arrange pages…" Click="ArrangePages_Click"/></ContextMenu></Border.ContextMenu>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Tint}" CornerRadius="5" Height="34" Width="37" VerticalAlignment="Center"><TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontWeight="SemiBold"/><TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="APPENDED" Visibility="{Binding AppendedVisibility}" Foreground="{StaticResource Burgundy}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <ComboBox Grid.Column="2" Width="92" IsEditable="True" ItemsSource="{x:Static core:NewsletterPlan.Years}" Text="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Visibility="{Binding SchoolYearVisibility}" AutomationProperties.Name="Year level" ToolTip="Prep, 1–12, or a group such as 5-6"/>
                <ComboBox Grid.Column="2" Width="140" IsEditable="True" ItemsSource="{Binding GroupChoices}" Text="{Binding CustomGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Visibility="{Binding CustomGroupVisibility}" AutomationProperties.Name="Group" ToolTip="Choose or type a group"/>
              </Grid>
            </Border>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="EmptyState" IsHitTestVisible="False" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="#FAFCFF" Margin="0,0,0,10">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="↓" Foreground="{StaticResource Accent}" FontSize="40" HorizontalAlignment="Center"/><TextBlock Text="Drop files or a folder" FontSize="16" Margin="0,9,0,0" HorizontalAlignment="Center"/><TextBlock Text="Word · PowerPoint · PDF · images" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
        </Border>
      </Grid>
      <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="UpButton" Content="↑" Click="Up_Click" Padding="12,6" ToolTip="Move up" AutomationProperties.Name="Move selected file up"/><Button x:Name="DownButton" Content="↓" Click="Down_Click" Padding="12,6" Margin="6,0,0,0" ToolTip="Move down" AutomationProperties.Name="Move selected file down"/><Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" Padding="12,6" Margin="6,0,0,0"/></StackPanel>
        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear" Click="Clear_Click" Padding="12,6" Background="White" BorderThickness="0"/>
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
