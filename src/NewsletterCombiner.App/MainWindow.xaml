<Window x:Class="NewsletterCombiner.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NewsletterCombiner.App" Title="GoodSort PDF" Icon="app.ico" Width="1180" Height="800" MinWidth="1000" MinHeight="800" WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="ModeChoice" TargetType="RadioButton">
      <Setter Property="Padding" Value="10,10"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Choice" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
          <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource Burgundy}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CompactModeChoice" TargetType="RadioButton" BasedOn="{StaticResource ModeChoice}">
      <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="7,9"/>
    </Style>
  </Window.Resources>
  <Grid Margin="30,24,30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Accent}" BorderBrush="{StaticResource Burgundy}" BorderThickness="0,0,0,4" CornerRadius="9" Padding="20,16" Margin="0,0,0,18">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="ⓘ" Click="About_Click" ToolTip="About GoodSort PDF" AutomationProperties.Name="About GoodSort PDF" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="White" Padding="8,2"/>
      <Border x:Name="ModeSelector" DockPanel.Dock="Right" BorderBrush="{StaticResource Sky}" BorderThickness="1" CornerRadius="4" Padding="3" Margin="12,0,10,0" VerticalAlignment="Center">
        <UniformGrid Columns="4">
          <RadioButton x:Name="NewsletterMode" GroupName="Mode" Content="Newsletters" Style="{StaticResource ModeChoice}" IsChecked="True" Checked="Mode_Changed" ToolTip="Prepare newsletters by year, term and weeks"/>
          <RadioButton x:Name="BulkMode" GroupName="Mode" Content="Bulk convert" Style="{StaticResource ModeChoice}" Checked="Mode_Changed" ToolTip="One PDF per input file"/>
          <RadioButton x:Name="CombineMode" GroupName="Mode" Content="Combine all" Style="{StaticResource ModeChoice}" Checked="Mode_Changed" ToolTip="All files in one PDF"/>
          <RadioButton x:Name="ArrangeMode" GroupName="Mode" Content="Arrange pages" Style="{StaticResource ModeChoice}" Checked="Mode_Changed" ToolTip="Reorder, duplicate or remove PDF pages"/>
        </UniformGrid>
      </Border>
      <StackPanel><TextBlock Text="GoodSort PDF" Foreground="White" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{x:Static local:AppInfo.ShortDescription}" Foreground="{StaticResource Sky}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
    </DockPanel>
    </Border>
    <Border x:Name="NamingArea" Grid.Row="1" Background="{StaticResource Tint}" CornerRadius="9" Padding="18,12" Margin="0,0,0,18">
      <Grid>
      <Grid x:Name="NamingControls">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="TermWeekControls" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Term" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TermBox" Width="50" SelectionChanged="Naming_Changed" AutomationProperties.Name="Term"/>
          <TextBlock x:Name="WeeksLabel" Text="Weeks" VerticalAlignment="Center" Margin="14,0,8,0"/><ComboBox x:Name="FirstWeekBox" Width="50" SelectionChanged="FirstWeek_Changed" AutomationProperties.Name="First week"/>
          <StackPanel x:Name="LastWeekControls" Orientation="Horizontal"><TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"/><ComboBox x:Name="LastWeekBox" Width="50" SelectionChanged="Naming_Changed" AutomationProperties.Name="Last week"/></StackPanel>
        </StackPanel>
        <Grid x:Name="CustomIssueControls" Visibility="Collapsed" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Issue" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Grid Grid.Column="1">
            <TextBox x:Name="IssueBox" TextChanged="DocumentName_Changed" AutomationProperties.Name="Custom issue label" AutomationProperties.HelpText="For example: October, Camp Update" ToolTip="For example: October, Camp Update"/>
            <TextBlock x:Name="IssuePlaceholder" Text="e.g. October, Camp Update" Foreground="{StaticResource Muted}" Opacity="0.75" FontSize="12" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=IssueBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>
        <Grid x:Name="CustomGroupsEditor" Grid.Column="1" Width="230" Margin="12,0,16,0" Visibility="Collapsed" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Groups" VerticalAlignment="Center"/>
          <TextBox x:Name="GroupNamesBox" Grid.Column="1" Text="Joeys, Cubs, Scouts" TextChanged="GroupNames_Changed" AutomationProperties.Name="Custom group names" AutomationProperties.HelpText="Separate group names with commas" ToolTip="Separate group names with commas, e.g. Joeys, Cubs, Scouts"/>
        </Grid>
        <StackPanel x:Name="NewsletterOptionsBar" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="3" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="FortnightlyChoice" GroupName="Frequency" Content="Fortnightly" Style="{StaticResource CompactModeChoice}" IsChecked="True" Checked="NewsletterOptions_Changed"/>
              <RadioButton x:Name="WeeklyChoice" GroupName="Frequency" Content="Weekly" Style="{StaticResource CompactModeChoice}" Checked="NewsletterOptions_Changed"/>
              <RadioButton x:Name="CustomIssueChoice" GroupName="Frequency" Content="Custom" Style="{StaticResource CompactModeChoice}" Checked="NewsletterOptions_Changed"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="3">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="YearGroupsChoice" GroupName="Grouping" Content="Year levels" Style="{StaticResource CompactModeChoice}" IsChecked="True" Checked="NewsletterOptions_Changed"/>
              <RadioButton x:Name="CustomGroupsChoice" GroupName="Grouping" Content="Custom groups" Style="{StaticResource CompactModeChoice}" Checked="NewsletterOptions_Changed"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <TextBlock x:Name="NamingPreview" Grid.Row="1" Margin="0,6,12,0" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Separate groups with commas." Margin="55,6,16,0" FontSize="11" Foreground="{StaticResource Muted}" Visibility="{Binding Visibility, ElementName=CustomGroupsEditor}"/>
      </Grid>
      <Grid x:Name="ArrangeNaming" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="PDF name" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBox x:Name="ArrangedNameBox" Grid.Column="1" TextChanged="DocumentName_Changed" AutomationProperties.Name="Arranged PDF filename" ToolTip="A new PDF is saved; the original stays unchanged."/>
      </Grid>
      <Grid x:Name="DocumentNaming" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="DocumentNameLabel" Text="Filename ending" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBox x:Name="SuffixBox" Grid.Column="1" TextChanged="DocumentName_Changed" AutomationProperties.Name="Filename ending" ToolTip="Optional text appended before .pdf, e.g. _ready_{date}. Spaces and separators are kept as typed."/>
        <TextBox x:Name="CombinedNameBox" Grid.Column="1" Text="Combined document" Visibility="Collapsed" TextChanged="DocumentName_Changed" AutomationProperties.Name="Combined PDF filename"/>
        <Button Grid.Column="2" Content="+ Variable" Click="Variable_Click" Margin="10,0,0,0">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Date · {date}" Tag="{}{date}" Click="InsertVariable_Click"/>
            <MenuItem Header="Time · {time}" Tag="{}{time}" Click="InsertVariable_Click"/>
            <MenuItem Header="Number · {n}" Tag="{}{n}" Click="InsertVariable_Click"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <TextBlock x:Name="DocumentPreview" Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2" x:Name="FileColumns">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="FileGap" Width="18"/><ColumnDefinition x:Name="NoticeColumn" Width="*"/></Grid.ColumnDefinitions>
      <local:FilePanel x:Name="NewslettersPanel" Heading="Newsletters" Subheading="Add newsletters to begin" IsNewsletter="True"/>
      <Grid x:Name="NoticeClip" Grid.Column="2" ClipToBounds="True"><local:FilePanel x:Name="NoticesPanel" Heading="Notices" Subheading="Added after every year’s newsletters"/></Grid>
    </Grid>
    <local:PageEditor x:Name="PageEditorControl" Grid.Row="2" Visibility="Collapsed"/>
    <Grid Grid.Row="3" x:Name="OutputControls" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Save to" VerticalAlignment="Center" Margin="0,0,15,0"/><TextBox Grid.Column="1" x:Name="OutputFolder" IsReadOnly="True" Background="White" AutomationProperties.Name="Output folder"/><Button Grid.Column="2" Content="Choose folder" Click="Folder_Click" Margin="10,0,0,0"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="{StaticResource Line}"/>
        <TextBlock FontSize="11" Margin="0,3,0,0"><Hyperlink x:Name="CreditLink" NavigateUri="{x:Static local:AppInfo.RepositoryUri}" RequestNavigate="Credit_RequestNavigate" Foreground="{StaticResource Muted}" ToolTip="Open GoodSort PDF on GitHub"><Run Text="{x:Static local:AppInfo.Credit}"/></Hyperlink></TextBlock>
      </StackPanel>
      <Button Grid.Column="1" x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolder_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
      <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" ToolTip="Stop this batch. Documents already sent to the printer may still print; use the Windows print queue to cancel them." Click="Cancel_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0" MaxWidth="380">
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="AddArrangedCheckBox" Content="Add to other modes" ToolTip="Replace the source item in the other modes, or add this PDF if it has no source item. The original file on disk is unchanged." Visibility="Collapsed" Margin="0,0,18,0" FontSize="12"/>
            <CheckBox x:Name="PrintAfterSavingCheckBox" Content="Print after saving" FontSize="12" ToolTip="Choose a printer once when you click GO. Save the PDFs, then send each output to that printer."/>
          </StackPanel>
          <TextBlock x:Name="ArrangeFooter" Visibility="Collapsed" Text="{Binding Text, ElementName=StatusText}" Margin="20,5,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Button x:Name="GoButton" Content="GO  →" Click="Go_Click" Width="154" Height="48" Background="{StaticResource Accent}" Foreground="White" FontSize="18" FontWeight="SemiBold" BorderThickness="0" IsEnabled="False"/></StackPanel>
    </Grid>
  </Grid>
</Window>
